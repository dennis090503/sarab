   ========================================================================== */
@media (max-width: 767px) {
  .mpbox {
    flex-direction: column !important;
    overflow-y: auto !important; /* Permits interior element scrolling on small screens */
    max-height: 85vh;
  }
  
  .mimg-container {
    width: 100% !important;
    height: 250px !important;
    min-height: 250px !important;
    flex: none !important;
  }

  #mpImg {
    height: 100% !important;
    width: 100% !important;
  }
}
/* ==========================================================================
   Responsive Adaptability Shifts (Mobile)
   ========================================================================== */
@media (max-width: 767px) {
  .mpbox {
    flex-direction: column !important;
    max-height: 92vh;
  }
  
  .mpbox > .col-md-5 {
    min-height: 240px !important;
    height: 240px !important;
    width: 100% !important;
  }
  
  .mpbox #mpImg {
    position: relative !important;
    height: 100% !important;
