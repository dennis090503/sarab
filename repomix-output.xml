  const navigate = useNavigate();
  
  if (!isOpen) return null;

  return (
    <div className="position-fixed top-0 end-0 h-100 bg-white shadow-lg border-start animate-slide-in" 
         style={{ width: '400px', zIndex: 10090, maxWidth: '100vw' }}>
      
