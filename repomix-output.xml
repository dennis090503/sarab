          to {
            transform: translateX(0);
          }
        }
        .btn-close:hover {
          opacity: 0.7;
        }
        .btn:hover {
          transform: translateY(-1px);
        }
        .btn:active {
          transform: translateY(0);
        }
      `}</style>
    </div>
  );
};

export default CartDrawer;
