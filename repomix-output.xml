                    +
                  </button>
                </div>
              </div>
              <button 
                className="btn p-2 border-0" 
                style={{ color: '#dc3545', background: 'transparent' }}
                onClick={() => removeFromCart(item.id)}
              >
                <i className="fas fa-trash-alt"></i>
              </button>
            </div>
          ))
        )}
      </div>

      {/* Checkout Matrix Footer Block */}
