import React, { useState, useEffect } from 'react';

const HistoryHours = () => {
  const [countdown, setCountdown] = useState({
    hours: 8,
    minutes: 45,
    seconds: 30
  });

  // Countdown timer for special offer
  useEffect(() => {
    const timer = setInterval(() => {
      setCountdown(prev => {
        let { hours, minutes, seconds } = prev;
        if (seconds > 0) {
          seconds--;
        } else if (minutes > 0) {
          minutes--;
          seconds = 59;
        } else if (hours > 0) {
          hours--;
          minutes = 59;
          seconds = 59;
        }
        return { hours, minutes, seconds };
