}

.filtbtn:hover {
  background-color: #e2e6ea !important;
}

.filtbtn.active:hover {
  background-color: var(--primary) !important;
}
/* ==========================================================================
   Premium Modal Image Aspect Ratio Fixes
   ========================================================================== */
#menuPop {
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  width: 100vw !important;
